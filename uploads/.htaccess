# /uploads only ever holds media submitted through the site (admin images and
# job-application CVs). Nothing in here should ever be executed, so refuse to
# serve anything executable. This is the backstop for the upload hole that let
# a PHP file be written into this directory: even if something gets in here
# again, it cannot be run.

<FilesMatch "(?i)\.(php|php[0-9]|phtml|phps|pht|phar|inc|cgi|pl|py|sh|bash|lua|rb|asp|aspx|jsp|jspx|shtml|htaccess|htpasswd)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Strip any handler that might otherwise execute a file in this directory, so
# anything that slips past the match above is served as an inert download.
RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl .py .sh
RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar
